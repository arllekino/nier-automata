digraph DFA {
  start -> {0};
  {0} [shape=circle];
  {1,2} [shape=circle];
  {3,4} [shape=circle];
  {5,6} [shape=circle];
  {7} [shape=doublecircle];

  {0} -> {1,2} [label="a"];
  {0} -> - [label="b"];
  {0} -> - [label="c"];
  {0} -> - [label="d"];
  {1,2} -> - [label="a"];
  {1,2} -> {3,4} [label="b"];
  {1,2} -> - [label="c"];
  {1,2} -> - [label="d"];
  {3,4} -> - [label="a"];
  {3,4} -> - [label="b"];
  {3,4} -> {5,6} [label="c"];
  {3,4} -> - [label="d"];
  {5,6} -> - [label="a"];
  {5,6} -> - [label="b"];
  {5,6} -> - [label="c"];
  {5,6} -> {7} [label="d"];
  {7} -> - [label="a"];
  {7} -> - [label="b"];
  {7} -> - [label="c"];
  {7} -> - [label="d"];
}
